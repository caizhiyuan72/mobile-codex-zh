<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#526746</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="MainActivityTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/main_window_background</item>
        <item name="android:statusBarColor">@color/main_window_background</item>
        <item name="android:navigationBarColor">@color/main_window_background</item>
        <item name="android:windowLightStatusBar">@bool/main_window_light</item>
        <item name="android:windowLightNavigationBar">@bool/main_window_light</item>
    </style>
</resources>
